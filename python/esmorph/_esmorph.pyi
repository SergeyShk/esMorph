from collections.abc import Iterable
from os import PathLike
from pathlib import Path
from typing import final

__version__: str

@final
class Analysis:
    @property
    def word(self) -> str: ...
    @property
    def lemma(self) -> str: ...
    @property
    def pos(self) -> str: ...
    @property
    def feats(self) -> dict[str, str]: ...
    @property
    def prob(self) -> float: ...
    @property
    def words(self) -> tuple[str, ...]: ...
    @property
    def source(self) -> str: ...

@final
class Analyzer:
    def __init__(self, path: str | PathLike[str] | None = None) -> None: ...
    @property
    def path(self) -> Path: ...
    def analyze(self, word: str) -> list[Analysis]: ...
    def analyze_many(self, words: Iterable[str]) -> list[list[Analysis]]: ...
    def lemmatize(self, words: Iterable[str]) -> list[str]: ...
    def is_known(self, word: str) -> bool: ...
